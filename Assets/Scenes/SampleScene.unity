  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingScreen
  stopObjects:
  - {fileID: 1284567301}
  lines:
  - "\uBE44\uC0C1\uAD6C \uCCA0\uBB38\uC744 \uBC00\uC790, \uCC28\uAC00\uC6B4 \uBC14\uB78C\uC774
    \uC5BC\uAD74\uC744 \uB54C\uB838\uB2E4."
  - "\uB208\uC740 \uADF8\uCCD0 \uC788\uC5C8\uB2E4. \uB3CC\uC544\uBCF8 \uB2E8\uC9C0\uC5D0\uB294
    \uC5B4\uB514\uC5D0\uB3C4 \uBD88\uC774 \uCF1C\uC838 \uC788\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC77C\uC8FC\uC77C \uB4A4, \uB2E8\uC9C0\uB294 \uC608\uC815\uB300\uB85C \uCCA0\uAC70\uB418\uC5C8\uB2E4."
  - "302\uD638 \uC790\uB9AC\uC5D0\uC11C\uB294 \uC791\uC740 \uC544\uC774 \uC2E0\uBC1C
    \uD55C \uCF24\uB808\uAC00 \uB098\uC654\uB2E4\uACE0 \uD55C\uB2E4."
  - "\uB098\uB294 \uC9C0\uAE08\uB3C4 \uBC24\uB9C8\uB2E4 \uD604\uAD00 \uBD88\uC744
    \uCF1C \uB450\uACE0 \uC794\uB2E4."
  lineTime: 4
  lineSize: 34
  endTitle: "\uACF5\uAC00"
  endSubTitle: "\u7A7A\u5BB6"
  thanks: "\uD50C\uB808\uC774\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4"
  fadeTime: 2.5
  endingMusic: {fileID: 2018186462}
